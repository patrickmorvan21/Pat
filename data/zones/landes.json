        "recontextualisation": null
      },
      "illustration": "assets/monstre_sonneur_sans_cloche_d.png",
      "portrait_requis": false
    },
    {
      "id": "epoux_du_verger",
      "nom": "Les Époux du Verger",
      "note": null,
      "lieu_attache": "verger_noir",
      "histoire_bailli": false,
      "rarete": "commune",
      "textes": {
        "decouverte": null,
        "familiarite": null,
        "recontextualisation": null
      },
      "illustration": "assets/monstre_epoux_verger_a.png",
      "portrait_requis": false
    },
    {
      "id": "marcheur_a_rebours",
      "nom": "Le Marcheur à rebours",
      "note": null,
      "lieu_attache": "chemin_creux",
      "histoire_bailli": false,
      "rarete": "commune",
      "textes": {
        "decouverte": "Il vient en sens inverse — à reculons. Il marche vite, sûr de ses pas, les yeux fixés sur ce qu'il fuit. Il ne s'arrête pour personne, mais il parle en passant : « Ça suit ceux qui suivent le chemin. »",
        "familiarite": null,
        "recontextualisation": null
      },
      "illustration": "assets/monstre_marcheur_a_rebours_d.png",
      "portrait_requis": false
    },
    {
      "id": "hesitant",
      "nom": "L'Hésitant",
      "note": "avant l'Appelé — il entend la voix et lutte encore",
      "lieu_attache": "borne_frontiere",
      "histoire_bailli": false,
      "rarete": "commune",
      "textes": {
        "decouverte": null,
        "familiarite": null,
        "recontextualisation": null
      },
      "illustration": "assets/monstre_hesitant_b.png",
      "portrait_requis": false
    },
    {
      "id": "veilleur_de_la_palissade",
      "nom": "Le Veilleur de la Palissade",
      "note": null,
      "lieu_attache": "palissade_sud",
      "histoire_bailli": false,
      "rarete": "commune",
      "textes": {
        "decouverte": "Sur le chemin de ronde, un vieux soldat regarde vers le sud. Trente ans qu'il guette une relève qui ne vient pas. « On ne rattrape pas les Appelés. On les compte. »",
        "familiarite": null,
        "recontextualisation": null
      },
      "illustration": null,
      "portrait_requis": false
    }
  ],
  "creatures": [
    {
