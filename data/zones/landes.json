    {
      "id": "appele",
      "nom": "L'Appelé",
      "note": "vers le sud — un Renonçant repris qui descend, toujours vu de dos",
      "lieu_attache": "palissade_sud",
      "histoire_bailli": false,
      "rarete": "commune",
      "textes": {
        "decouverte": "Un homme descend le chemin de la Descente d'un pas égal, sans bagage, sans se retourner. Le pas de quelqu'un qui n'obéit pas à ses jambes. Juste avant le tournant, il s'arrête une seconde — comme si, tout au fond, quelque chose en lui se débattait encore. Toujours vu de dos.",
        "familiarite": null,
        "recontextualisation": null
      },
      "illustration": null,
      "portrait_requis": false
    }
