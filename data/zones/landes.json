{
  "zone": {
    "id": "landes",
    "nom": "Les Landes",
    "acte": 1,
    "statut": "gelee",
    "heure_figee": "crépuscule éternel",
    "particularites": [
      "Le Serment : imposé à l'entrée du hameau par les Renonçants (ils exigent, ne proposent pas). Contrainte tenue jusqu'à la sortie de zone = récompense ; rompue = le Geôlier s'en souvient."
    ],
    "bruit_ecrit": "quelque part, une corde grince",
    "motif_cache": "le sceau du Bailli dissimulé dans chaque illustration de la zone",
    "sortie": {
      "id": "la_descente",
      "nom": "La Descente →",
      "note": "sortie de zone (Acte II)"
    }
  },
  "lieux": [
    {
      "id": "colline_aux_gibets",
      "nom": "La Colline aux Gibets",
      "note": "lieu-signature · le Gibet Vide",
      "lieu_attache": null,
      "histoire_bailli": true,
      "rarete": "commune",
      "textes": {
        "decouverte": "La colline monte seule au milieu de la lande, couronnée de gibets. Tous occupés, tous immobiles — sauf un. Au centre, le plus grand est vide ; sa corde pend, usée en son milieu.",
        "familiarite": null,
        "recontextualisation": null
      },
      "illustration": "assets/scene_colline_aux_gibets_c.png",
      "portrait_requis": false
    },
    {
      "id": "champ_des_fixes",
      "nom": "Le Champ des Fixés",
      "note": "cimetière des pendus",
      "lieu_attache": null,
      "histoire_bailli": false,
      "rarete": "commune",
      "textes": {
        "decouverte": "Des rangées de poteaux à perte de vue, chacun son pendu, chacun son écriteau. Un cimetière debout. On n'enterre pas, ici : on fixe. Les morts tiennent mieux le sol que les vivants.",
        "familiarite": null,
        "recontextualisation": null
      },
      "illustration": "assets/scene_champ_des_fixes_b.png",
      "portrait_requis": false
    },
    {
      "id": "moulin_sans_ailes",
      "nom": "Le Moulin sans Ailes",
      "note": "refuge supposé de la Fille",
      "lieu_attache": null,
      "histoire_bailli": false,
      "rarete": "commune",
      "textes": {
        "decouverte": "À l'écart du hameau, un moulin sans ailes tient debout par habitude. Dedans, un lit de bruyère tassée — plusieurs fois refait, jamais brûlé. Un refuge qui sert, donc un refuge qui marche.",
        "familiarite": null,
        "recontextualisation": null
      },
      "illustration": "assets/scene_moulin_sans_ailes_d_d.png",
      "portrait_requis": false
    },
    {
      "id": "mare_aux_regards",
      "nom": "La Mare aux Regards",
      "note": "le reflet en retard",
      "lieu_attache": null,
      "histoire_bailli": false,
      "rarete": "commune",
      "textes": {
        "decouverte": null,
        "familiarite": null,
        "recontextualisation": null
      },
      "illustration": "assets/scene_mare_aux_regards_a.png",
      "portrait_requis": false
    },
    {
      "id": "hameau_des_renoncants",
      "nom": "Le Hameau des Renonçants",
      "note": "région englobante (cadre pointillé) : contient la Chapelle des Cordes, la Maison du Bailli, le Petit Tribunal, le Puits Condamné, le Marché Muet et la Tour de Guet effondrée · le Serment s'impose à son entrée",
      "lieu_attache": null,
      "histoire_bailli": false,
      "rarete": "commune",
      "textes": {
        "decouverte": "Des murets de pierre sèche, des toits bas, pas une flamme. Ici, on renonce : chacun laisse une chose au muret — son nom, sa hâte, sa lame ou sa langue — et jure de tenir jusqu'à la sortie des Landes. Ce n'est pas une proposition.",
        "familiarite": null,
        "recontextualisation": null
      },
      "illustration": "assets/scene_hameau_dense2_b.png",
      "portrait_requis": false
    },
    {
      "id": "chapelle_des_cordes",
      "nom": "La Chapelle des Cordes",
      "note": "reliques des fixations",
      "lieu_attache": null,
      "histoire_bailli": false,
      "rarete": "commune",
      "textes": {
        "decouverte": "Ni croix ni autel. Aux murs, des dizaines de cordes clouées en boucles soigneuses, chacune sous un nom gravé — les reliques des Fixations réussies. Certaines bougent doucement, sans courant d'air.",
        "familiarite": null,
        "recontextualisation": null
      },
      "illustration": "assets/scene_chapelle_des_cordes_d.png",
      "portrait_requis": false
    },
    {
      "id": "maison_du_bailli",
      "nom": "La Maison du Bailli",
      "note": "murée de l'intérieur",
      "lieu_attache": null,
      "histoire_bailli": true,
      "rarete": "commune",
      "textes": {
        "decouverte": "La plus grande maison du hameau est murée — de l'intérieur. Chaque fenêtre bouchée de pierres posées depuis dedans, par quelqu'un qui s'enfermait plus qu'il ne se protégeait.",
        "familiarite": null,
        "recontextualisation": null
      },
      "illustration": "assets/scene_maison_du_bailli_c.png",
      "portrait_requis": false
    },
    {
      "id": "petit_tribunal",
      "nom": "Le Petit Tribunal",
      "note": "la Fixation y est jugée",
      "lieu_attache": null,
      "histoire_bailli": true,
      "rarete": "commune",
      "textes": {
        "decouverte": "Une seule pièce : trois bancs, une chaire, et le froid des endroits où l'on a beaucoup décidé. C'est ici que la Fixation se jugeait — le Bailli en chaire, la corde en sentence unique.",
        "familiarite": null,
        "recontextualisation": null
      },
      "illustration": "assets/scene_petit_tribunal_a.png",
      "portrait_requis": false
    },
    {
      "id": "puits_condamne",
      "nom": "Le Puits Condamné",
      "note": "planches et chaînes",
      "lieu_attache": null,
      "histoire_bailli": false,
      "rarete": "commune",
      "textes": {
        "decouverte": "Un puits condamné de frais : planches neuves, chaînes croisées, cadenas encore gras. Tout le hameau tombe en ruine douce, mais ça, on l'entretient. Et dessous, ça cogne. Trois coups, une pause. Trois coups.",
        "familiarite": null,
        "recontextualisation": null
      },
      "illustration": "assets/scene_puits_condamne_c.png",
      "portrait_requis": false
    },
    {
      "id": "marche_muet",
      "nom": "Le Marché Muet",
      "note": "troc sans paroles · Colporteur",
      "lieu_attache": null,
      "histoire_bailli": false,
      "rarete": "commune",
      "textes": {
        "decouverte": "Un marché sans un cri, au cœur du hameau. Des étals de trois fois rien, des marchands qui négocient par gestes, paumes et hochements. Renoncer à la parole est le renoncement le plus courant. Le moins cher.",
        "familiarite": null,
        "recontextualisation": null
      },
      "illustration": "assets/scene_marche_muet_c.png",
      "portrait_requis": false
    },
    {
      "id": "tour_de_guet_effondree",
      "nom": "La Tour de Guet effondrée",
      "note": "elle surveillait l'intérieur",
      "lieu_attache": null,
      "histoire_bailli": false,
      "rarete": "commune",
      "textes": {
        "decouverte": null,
        "familiarite": null,
        "recontextualisation": null
      },
      "illustration": null,
      "portrait_requis": false
    },
    {
      "id": "verger_noir",
      "nom": "Le Verger Noir",
      "note": "fruits de cendre",
      "lieu_attache": null,
      "histoire_bailli": false,
      "rarete": "commune",
      "textes": {
        "decouverte": null,
        "familiarite": null,
        "recontextualisation": null
      },
      "illustration": "assets/scene_verger_noir_d.png",
      "portrait_requis": false
    },
    {
      "id": "chemin_creux",
      "nom": "Le Chemin Creux",
      "note": "vu sans voir",
      "lieu_attache": null,
      "histoire_bailli": false,
      "rarete": "commune",
      "textes": {
        "decouverte": "Le chemin s'enfonce entre deux talus plus hauts qu'un homme. On y marche vu sans voir : la lande entière vous regarde passer, et vous ne voyez que de la terre.",
        "familiarite": null,
        "recontextualisation": null
      },
      "illustration": "assets/scene_chemin_creux_c.png",
      "portrait_requis": false
    },
    {
      "id": "borne_frontiere",
      "nom": "La Borne Frontière",
      "note": "limite des Renonçants",
      "lieu_attache": null,
      "histoire_bailli": false,
      "rarete": "commune",
      "textes": {
        "decouverte": "Au bord du chemin, une borne de pierre penche sous les offrandes : bouts de pain durci, rubans, clous tordus. On paie ici pour entrer. Ou pour qu'on vous laisse ressortir.",
        "familiarite": null,
        "recontextualisation": null
      },
      "illustration": "assets/scene_transition_borne_sud_a.png",
      "portrait_requis": false
    },
    {
      "id": "palissade_sud",
      "nom": "La Palissade Sud",
      "note": "le mur côté Profondeurs",
      "lieu_attache": null,
      "histoire_bailli": false,
      "rarete": "commune",
      "textes": {
        "decouverte": "Une palissade de troncs noircis barre l'horizon d'est en ouest. Les étais sont de ce côté-ci : elle n'empêche pas d'entrer. Au centre, une porte à double battant — et derrière, un chemin qui descend, où l'air coule comme une eau froide.",
        "familiarite": null,
        "recontextualisation": null
      },
      "illustration": null,
      "portrait_requis": false
    }
  ],
  "rencontres": [
    {
      "id": "pendu_qui_parle",
      "nom": "Le Pendu qui parle",
      "note": "gardien-jalon de la zone — le Bailli lui-même, pendu à hauteur d'homme près du Gibet Vide",
      "lieu_attache": "colline_aux_gibets",
      "histoire_bailli": true,
      "rarete": "commune",
      "gardien": true,
      "etats": [
        "intact",
        "balafre",
        "rompu"
      ],
      "textes": {
        "decouverte": "Un gibet bas, à hauteur d'homme. Le pendu qui s'y balance ouvre les yeux quand on approche : chaîne de fonction au cou, sceau au poing. Le Bailli des Landes — pendu le dernier, à la place d'honneur. Tout ce qui entre dans ses Landes passe en jugement.",
        "familiarite": null,
        "recontextualisation": null
      },
      "illustration": "assets/monstre_pendu_qui_parle_a.png",
      "portrait_requis": false
    },
    {
      "id": "fossoyeur_des_poteaux",
      "nom": "Le Fossoyeur des Poteaux",
      "note": null,
      "lieu_attache": "champ_des_fixes",
      "histoire_bailli": false,
      "rarete": "commune",
      "textes": {
        "decouverte": "Entre les rangs du Champ, un vieil homme redresse les poteaux qui penchent, avec des gestes de jardinier. « Ils dorment mal quand ça penche. » Son carnet tient le plan des rangs — et une croix là où il ne faut jamais passer.",
        "familiarite": null,
        "recontextualisation": null
      },
      "illustration": "assets/monstre_fossoyeur_poteaux_a.png",
      "portrait_requis": false
    },
    {
      "id": "petite_fixee",
      "nom": "La Petite Fixée",
      "note": null,
      "lieu_attache": "champ_des_fixes",
      "histoire_bailli": false,
      "rarete": "commune",
      "textes": {
        "decouverte": "Au bout d'une corde trop courte, une petite fille pend sans se balancer. Les autres fixés regardent tous droit devant. Pas elle : elle vous suit des yeux.",
        "familiarite": null,
        "recontextualisation": null
      },
      "illustration": "assets/monstre_petite_fixee_c.png",
      "portrait_requis": false
    },
    {
      "id": "fille",
      "nom": "La Fille",
      "note": "la fille du Bailli — la seule pendue qui se soit relevée ; elle erre encore",
      "lieu_attache": "moulin_sans_ailes",
      "histoire_bailli": true,
      "rarete": "rare",
      "textes": {
        "decouverte": null,
        "familiarite": null,
        "recontextualisation": null
      },
      "illustration": null,
      "portrait_requis": false
    },
    {
      "id": "veuve_aux_cordes",
      "nom": "La Veuve aux Cordes",
      "note": null,
      "lieu_attache": "chapelle_des_cordes",
      "histoire_bailli": false,
      "rarete": "commune",
      "textes": {
        "decouverte": "Une femme en noir, au pied du mur de la chapelle, qui refait sans fin le même nœud. Le nœud qu'elle apprend n'attache rien — il retient quelqu'un de partir dans sa tête.",
        "familiarite": null,
        "recontextualisation": null
      },
      "illustration": "assets/monstre_veuve_cordes_a.png",
      "portrait_requis": false
    },
    {
      "id": "deserteur_du_tribunal",
      "nom": "Le Déserteur du Tribunal",
      "note": null,
      "lieu_attache": "petit_tribunal",
      "histoire_bailli": false,
      "rarete": "commune",
      "textes": {
        "decouverte": null,
        "familiarite": null,
        "recontextualisation": null
      },
      "illustration": null,
      "portrait_requis": false
    },
    {
      "id": "ecrivain_public",
      "nom": "L'Écrivain public",
      "note": null,
      "lieu_attache": "petit_tribunal",
      "histoire_bailli": false,
      "rarete": "commune",
      "textes": {
        "decouverte": "Un petit homme sec, plume en main, qui copie le Registre des Pendaisons sans lever les yeux. Il désigne le Registre du bout de sa plume : votre page est prête.",
        "familiarite": null,
        "recontextualisation": null
      },
      "illustration": "assets/monstre_ecrivain_public_d.png",
      "portrait_requis": false
    },
    {
      "id": "colporteur",
      "nom": "Le Colporteur",
      "note": "PNJ récurrent transverse — se souvient des runs précédentes, troc par souvenirs et Jours",
      "lieu_attache": "marche_muet",
      "histoire_bailli": false,
      "rarete": "commune",
      "recurrent": true,
      "textes": {
        "decouverte": "Au bout du Marché Muet, un étal différent : bric-à-brac d'ailleurs, objets qui n'ont rien à faire dans une lande. Le Colporteur vous regarde venir de loin — et vous reconnaît. C'est impossible. Il vous fait signe quand même.",
        "familiarite": null,
        "recontextualisation": null
      },
      "illustration": "assets/monstre_colporteur_b.png",
      "portrait_requis": false
    },
    {
      "id": "rebouteux",
      "nom": "Le Rebouteux",
      "note": null,
      "lieu_attache": "marche_muet",
      "histoire_bailli": false,
      "rarete": "commune",
      "textes": {
        "decouverte": "Des mains dures et savantes, qui palpent une blessure comme on lit une lettre. Il remet en place ce qui peut l'être, refuse ce qui le dépasse — et ce qu'il sent parfois sous la peau, il ne le soigne pas. Il le salue.",
        "familiarite": null,
        "recontextualisation": null
      },
      "illustration": "assets/monstre_rebouteux_a.png",
      "portrait_requis": false
    },
    {
      "id": "doyenne",
      "nom": "La Doyenne",
      "note": null,
      "lieu_attache": "hameau_des_renoncants",
      "histoire_bailli": false,
      "rarete": "commune",
      "textes": {
        "decouverte": "Sur le seuil du premier muret, une vieille femme barre le passage, paumes ouvertes — pas en accueil. En douane. C'est elle qui exige le Serment, et le hameau entier attend derrière elle, aux fenêtres sans lumière.",
        "familiarite": null,
        "recontextualisation": null
      },
      "illustration": "assets/monstre_doyenne_b.png",
      "portrait_requis": false
    },
    {
      "id": "femme_au_seuil",
      "nom": "La Femme au Seuil",
      "note": null,
      "lieu_attache": "hameau_des_renoncants",
      "histoire_bailli": false,
      "rarete": "commune",
      "textes": {
        "decouverte": null,
        "familiarite": null,
        "recontextualisation": null
      },
      "illustration": "assets/monstre_femme_au_seuil_b.png",
      "portrait_requis": false
    },
    {
      "id": "gamin_des_murets",
      "nom": "Le Gamin des Murets",
      "note": null,
      "lieu_attache": "hameau_des_renoncants",
      "histoire_bailli": false,
      "rarete": "commune",
      "textes": {
        "decouverte": null,
        "familiarite": null,
        "recontextualisation": null
      },
      "illustration": null,
      "portrait_requis": false
    },
    {
      "id": "sonneur_sans_cloche",
      "nom": "Le Sonneur sans Cloche",
      "note": null,
      "lieu_attache": "hameau_des_renoncants",
      "histoire_bailli": false,
      "rarete": "commune",
      "textes": {
        "decouverte": null,
