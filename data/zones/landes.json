    {
      "id": "voix_basses",
      "nom": "Les Voix Basses",
      "note": "phénomène (marqué tel quel sur la carte)",
      "lieu_attache": null,
      "histoire_bailli": false,
      "rarete": "commune",
      "textes": {
        "decouverte": "Sous le vent, des voix — basses, à ras de bruyère, qui se passent le mot des arrivées. Elles ne menacent pas. Elles préviennent quelqu'un.",
